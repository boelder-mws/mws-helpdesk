# Copy to .env and fill in. Lines marked REQUIRED must be set before first start.

# ---- Site -------------------------------------------------------------------
# REQUIRED. The address people type, with no trailing slash. Sign-in redirects
# and links in emails are built from it.
APP_URL=https://helpdesk.example.org
# Only for the built-in HTTPS proxy (docker compose --profile tls): the host
# name in APP_URL.
HELPDESK_DOMAIN=helpdesk.example.org
# Name shown in the sidebar, sign-in page and emails.
ORG_NAME=IT Helpdesk
# Timezone for dates and for business hours (IANA name).
APP_TIMEZONE=America/Chicago

# ---- Database ---------------------------------------------------------------
# REQUIRED. Letters and digits only (it goes into a connection URL).
# Generate one with:  openssl rand -hex 24
POSTGRES_PASSWORD=

# ---- Sign-in (OpenID Connect) -----------------------------------------------
# REQUIRED. Register the helpdesk with your identity provider as a "web"
# application with this redirect URI:   <APP_URL>/auth/callback
#
# Issuer examples:
#   Microsoft Entra ID   https://login.microsoftonline.com/<tenant-id>/v2.0
#   Google Workspace     https://accounts.google.com
#   Keycloak             https://sso.example.org/realms/<realm>
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Label on the sign-in button: "Sign in with <name>".
OIDC_PROVIDER_NAME=Microsoft
OIDC_SCOPES=openid profile email

# REQUIRED for first setup. These people are made admins when they sign in
# (comma-separated emails). Admins can then promote others in Settings.
ADMIN_EMAILS=

# Optional. Only allow accounts from these email domains (comma-separated).
# Recommended with Google, where any Google account could otherwise sign in.
OIDC_ALLOWED_DOMAINS=

# Optional. Set roles from identity-provider groups instead of by hand. When
# set, each sign-in re-applies the role: admin group > agent group > requester.
# OIDC_GROUPS_CLAIM is the ID-token claim listing groups (often "groups";
# Entra sends group object IDs).
OIDC_GROUPS_CLAIM=
OIDC_ADMIN_GROUPS=
OIDC_AGENT_GROUPS=

# ---- Email notifications (optional) -----------------------------------------
# Leave SMTP_HOST empty to turn email off.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); false for 587/25 (STARTTLS when offered).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=IT Helpdesk <helpdesk@example.org>

# ---- Advanced ---------------------------------------------------------------
# Host port the app listens on (bound to 127.0.0.1 only).
APP_PORT=3000
# Development only: allow an http:// identity provider (e.g. local Keycloak).
# OIDC_ALLOW_INSECURE=true
